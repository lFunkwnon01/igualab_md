# Copia este archivo a  .env.local  y pega tus keys reales.
# .env.local está en .gitignore (NO se sube al repo).

# --- LLM (chat) ---
# DeepSeek:  base https://api.deepseek.com  · modelo deepseek-chat  · key sk-...
# OpenRouter: base https://openrouter.ai/api/v1 · modelo z-ai/glm-5.2:free · key sk-or-v1-...
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-pon-tu-key-aqui
LLM_MODEL=deepseek-chat

# --- Embeddings (NVIDIA NIM / Google) — opcional ---
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=nvapi-pon-tu-key-aqui
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
