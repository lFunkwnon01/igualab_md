<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Igualab" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Igualab">
    <bpmn:participant id="Pool_Igualab" name="Igualab — Prospección comercial (proceso E2E)" processRef="Process_Igualab"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Igualab" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Igualab">
      <bpmn:lane id="Lane_Plataforma" name="Plataforma Igualab (automático)">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista comercial (Análisis)">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Empresa" name="Empresa objetivo (externo)">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Información nueva analizada (base del cliente)"></bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Priorizar empresas con brechas y sanciones"></bpmn:serviceTask>
    <bpmn:serviceTask id="T1b" name="Archivar observación para el siguiente ciclo"></bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Generar perfil de oportunidad"></bpmn:serviceTask>
    <bpmn:userTask id="T3" name="Registrar la oportunidad en seguimiento (contacto institucional)"></bpmn:userTask>
    <bpmn:userTask id="T5" name="Preparar dossier de prospección (reporte + propuesta de valor)"></bpmn:userTask>
    <bpmn:userTask id="T6" name="Acercarse a la empresa como aliado estratégico"></bpmn:userTask>
    <bpmn:userTask id="T7" name="Evaluar propuesta de valor"></bpmn:userTask>
    <bpmn:userTask id="T8" name="Coordinar reunión de trabajo"></bpmn:userTask>
    <bpmn:userTask id="T10" name="Programar seguimiento en el próximo ciclo anual"></bpmn:userTask>
    <bpmn:userTask id="T9" name="Presentar propuesta de consultoría retribuida"></bpmn:userTask>
    <bpmn:userTask id="T11" name="Formalizar contrato de consultoría"></bpmn:userTask>
    <bpmn:userTask id="T12" name="Prestar la consultoría con soporte analítico de la plataforma"></bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Brecha o sanción relevante?"></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="¿Contacto clave identificado?"></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="¿Empresa interesada?"></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G5" name="¿Acepta el servicio?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Sin oportunidad por ahora"></bpmn:endEvent>
    <bpmn:endEvent id="E2" name="Oportunidad en seguimiento"></bpmn:endEvent>
    <bpmn:endEvent id="E3" name="En seguimiento (próximo ciclo)"></bpmn:endEvent>
    <bpmn:endEvent id="E4" name="Ingreso retribuido e impacto de sostenibilidad"></bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="G1"/>
    <bpmn:sequenceFlow id="F03" name="No" sourceRef="G1" targetRef="T1b"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T1b" targetRef="E1"/>
    <bpmn:sequenceFlow id="F05" name="Sí" sourceRef="G1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F06" sourceRef="T2" targetRef="G2"/>
    <bpmn:sequenceFlow id="F07" name="No" sourceRef="G2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F08" sourceRef="T3" targetRef="E2"/>
    <bpmn:sequenceFlow id="F12" name="Sí" sourceRef="G2" targetRef="T5"/>
    <bpmn:sequenceFlow id="F13" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T6" targetRef="T7"/>
    <bpmn:sequenceFlow id="F15" sourceRef="T7" targetRef="G4"/>
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="G4" targetRef="T10"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T10" targetRef="E3"/>
    <bpmn:sequenceFlow id="F18" name="Sí" sourceRef="G4" targetRef="T8"/>
    <bpmn:sequenceFlow id="F19" sourceRef="T8" targetRef="T9"/>
    <bpmn:sequenceFlow id="F20" sourceRef="T9" targetRef="G5"/>
    <bpmn:sequenceFlow id="F21" name="Sí" sourceRef="G5" targetRef="T11"/>
    <bpmn:sequenceFlow id="F22" sourceRef="T11" targetRef="T12"/>
    <bpmn:sequenceFlow id="F23" sourceRef="T12" targetRef="E4"/>
    <bpmn:sequenceFlow id="F24" name="No" sourceRef="G5" targetRef="T10"/>
  </bpmn:process>
